<!-- lavalynx: launcher foreground. A geometric lynx head (tufted ears, cheek ruff) in a
     lava gradient; the eyes and nose are cut out in the background colour. The design is
     drawn in the full 108dp canvas and scaled to sit inside the 66dp adaptive safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <path
            android:pathData="M32,43 L28,26 L26,14 L31,23 L42,37 Q54,32 66,37 L77,23 L82,14 L80,26 L76,43 Q79,52 76,60 L79,68 L63,76 Q54,80 45,76 L29,68 L32,60 Q29,52 32,43 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="14"
                    android:endX="54"
                    android:endY="80"
                    android:type="linear">
                    <item android:offset="0" android:color="#FFFFB32B"/>
                    <item android:offset="0.55" android:color="#FFFF5A1F"/>
                    <item android:offset="1" android:color="#FFB8102E"/>
                </gradient>
            </aapt:attr>
        </path>
        <!-- Eyes and nose, cut out in the launcher background colour. -->
        <path
            android:fillColor="@color/ic_launcher_background"
            android:pathData="M40,53 Q45,47 51,50 Q46,55 40,53 Z M68,53 Q63,47 57,50 Q62,55 68,53 Z M51,63 L57,63 L54,67.5 Z" />
    </group>
</vector>
