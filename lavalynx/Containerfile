####
# lavalynx build toolchain. Everything mach needs that would otherwise be an apt
# install; mach bootstrap then puts the JDK, Android SDK, node and python deps
# into the cache volume (see lavalynx/dev), nothing on the host.
#   podman build -t lavalynx-build -f lavalynx/Containerfile lavalynx
####
FROM docker.io/library/ubuntu:24.04

# Pinned so builds are reproducible. Bump deliberately.
# jj matches the host's: mach detects the jj checkout and asks jj for the
# working-copy commit when choosing which Gecko artifacts to download.
ARG JJ_VERSION=0.47.1

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# What mozboot's Linux bootstrapper would apt-get, plus what mach's python
# virtualenv needs to build the odd wheel without a manylinux build.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl file findutils git gzip make perl tar unzip zip xz-utils \
        python3 python3-venv python3-pip python3-dev build-essential pkg-config libssl-dev \
        procps less \
    && rm -rf /var/lib/apt/lists/*

# Shared libraries the Android emulator loads even when headless (`lavalynx/dev emulator`).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 \
        libxi6 libxrandr2 libxtst6 libxkbfile1 libxkbcommon0 libxkbcommon-x11-0 libxcb1 libxcb-xinerama0 \
        libnss3 libnspr4 libdbus-1-3 libpulse0 libasound2t64 libgl1 libegl1 libgbm1 libdrm2 libbsd0 \
        libfontconfig1 libfreetype6 libglib2.0-0t64 libxshmfence1 libuuid1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/jj-vcs/jj/releases/download/v${JJ_VERSION}/jj-v${JJ_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
        -o /tmp/jj.tar.gz \
    && tar -xzf /tmp/jj.tar.gz -C /tmp \
    && install -m 0755 "$(find /tmp -maxdepth 2 -type f -name jj | head -1)" /usr/local/bin/jj \
    && rm -rf /tmp/jj.tar.gz /tmp/jj* \
    && jj --version

# Caches are bind-mounted volumes; the build runs as the host UID via --userns=keep-id,
# so these have to be writable by an arbitrary uid. HOME is /cache/home.
RUN mkdir -p /cache/home /cache/mozbuild /cache/gradle /work \
    && chmod -R 0777 /cache

WORKDIR /work
CMD ["bash"]
